# URL de la API. Vacío = "/api" en el mismo origen (producción: lo atiende el proxy de frontend/server.mjs;
# desarrollo: el proxy de Vite hacia http://localhost:3000). Solo se define para apuntar a otra API.
# VITE_API_URL=
# URL del panel (login + dashboard). Vacío = "/dashboard" en el mismo origen.
