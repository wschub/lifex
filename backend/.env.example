DATABASE_URL="postgresql://app:app@127.0.0.1:55432/lifex"
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Duración de los tokens: número + unidad (s, m, h, d). Ejemplos: 30s, 50m, 1h, 7d
ACCESS_TOKEN_EXPIRATION_TIME=60m
REFRESH_TOKEN_EXPIRATION_TIME=7d
# Secreto de firma de los JWT: mínimo 32 caracteres aleatorios (genéralo con: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-with-at-least-32-random-characters

# Recuperación de contraseña: vigencia del enlace (el código de 6 dígitos dura como máximo 10m)
# y página del front que recibe el token (se le añade ?token=...).
PASSWORD_RESET_EXPIRATION_TIME=30m
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Registro abierto al público (true o false)
PUBLIC_REGISTRATION=true
# SameSite de la cookie del refresh token: strict, lax o none (none exige NODE_ENV=production)
COOKIE_SAME_SITE=strict
# Orígenes del front que pueden llamar a la API desde un navegador, separados por comas
# (sin barra final ni comodín). Vacío = CORS desactivado.
CORS_ORIGINS=
# Emisor y audiencia de los JWT
JWT_ISSUER=backend
JWT_AUDIENCE=backend-api

# Número de proxies de confianza delante de la API (0 = ninguno).
# Detrás de un proxy o balanceador (Railway, Render, Nginx...) suele ser 1. Con 0, todos los
# clientes parecerían tener la IP del proxy y compartirían los límites de intentos.
TRUST_PROXY=0

# ── Dominio de reservas ──
# Minutos que dura el bloqueo temporal de un asiento
MAX_SEAT_LOCK_TIME=15
# Máximo de asientos que una sesión puede mantener bloqueados a la vez
MAX_HELD_SEATS_PER_SESSION=6
# Tasa USD→COP para mostrar precios en español
IATA_TRM=3300
# Vigencia del token de sesión de invitado (reserva en curso)
BOOKING_TOKEN_EXPIRATION_TIME=45m
# Impuestos (% sobre el precio del vuelo)
TAX_PERCENTAGE=19
# Reintentos máximos de un evento del outbox
OUTBOX_MAX_ATTEMPTS=5
# Correo (Brevo). Sin API key, el envío solo se registra en el log.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@lifex.test
BREVO_SENDER_NAME=Lifex
# URL pública de esta API (los correos enlazan la imagen QR del ticket desde aquí)
PUBLIC_API_URL=http://localhost:3000
# URL pública del frontend (los correos cargan allí el logo, en /mail/...)
APP_URL=http://localhost:5173

# start-stack:env-example
